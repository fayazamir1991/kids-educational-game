{
  "name": "kids-educational-game",
  "version": "1.0.0",
  "description": "A gentle Persian listening game for toddlers",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/verify-recordings.mjs && vite build",
    "build:standalone": "npm run build && node scripts/build-standalone.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/game.test.js",
    "test:e2e": "playwright test",
    "test:standalone": "npm run build:standalone && node tests/standalone-smoke.mjs",
    "test:audio": "node scripts/verify-recordings.mjs"
  },
  "repository": {
    "type": "git",
